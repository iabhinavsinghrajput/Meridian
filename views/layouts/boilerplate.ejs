<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Meridian</title>
    <!-- Google Fonts Outfit -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link href="/css/rating.css" rel="stylesheet" />
    <style>
      html.lenis, html.lenis body {
        height: auto;
      }
      .lenis.lenis-smooth {
        scroll-behavior: auto !important;
      }
      .lenis.lenis-smooth [data-lenis-prevent] {
        overscroll-behavior: contain;
      }
      .lenis.lenis-stopped {
        overflow: hidden;
      }
      .lenis.lenis-scrolling iframe {
        pointer-events: none;
      }
    </style>
  </head>
  <body>
    <!-- Page Loader -->
    <div id="page-loader">
      <div class="spinner"></div>
    </div>

    <div class="page-wrapper">
      <%- include("../includes/navbar.ejs") %>

      <!-- Toasts / Flash Messages -->
      <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <%- include("../includes/flash") %>
      </div>

      <main class="content container">
        <%- body %>
      </main>
    </div>
    
    <%- include("../includes/footer") %>
    
    <!-- Mobile Bottom Navigation Bar -->
    <div class="bottom-nav d-md-none text-muted">
      <a href="/listings" class="bottom-nav-item text-decoration-none text-center">
        <i class="fa-solid fa-magnifying-glass mb-1 fs-5"></i>
        <span>Explore</span>
      </a>
      <a href="/profile" class="bottom-nav-item text-decoration-none text-center">
        <i class="fa-regular fa-heart mb-1 fs-5"></i>
        <span>Wishlist</span>
      </a>
      <% if(!currUser) { %>
        <a href="/login" class="bottom-nav-item text-decoration-none text-center">
          <i class="fa-regular fa-user mb-1 fs-5"></i>
          <span>Log in</span>
        </a>
      <% } else { %>
        <a href="/profile" class="bottom-nav-item text-decoration-none text-center">
          <i class="fa-solid fa-user-circle mb-1 fs-5"></i>
          <span>Profile</span>
        </a>
      <% } %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
      // Remove loader when page loads
      window.addEventListener('load', () => {
        const loader = document.getElementById('page-loader');
        loader.style.opacity = '0';
        setTimeout(() => loader.style.display = 'none', 500);
        
        // Initialize Toasts
        const toastElList = document.querySelectorAll('.toast');
        const toastList = [...toastElList].map(toastEl => new bootstrap.Toast(toastEl, { delay: 4000 }));
        toastList.forEach(toast => toast.show());

        // Initialize SweetAlert for forms with class 'delete-form-sa'
        const deleteForms = document.querySelectorAll('.delete-form-sa');
        deleteForms.forEach(form => {
          form.addEventListener('submit', function(e) {
            e.preventDefault();
            Swal.fire({
              title: 'Are you really sure?',
              text: "This listing will be permanently removed!",
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#e63946',
              cancelButtonColor: '#6c757d',
              confirmButtonText: 'Yes, delete it!',
              cancelButtonText: 'Cancel'
            }).then((result) => {
              if (result.isConfirmed) {
                form.submit();
              }
            });
          });
        });
      });
    </script>
    <script src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js"></script>
    <script>
      // Initialize Lenis
      const lenis = new Lenis({
        lerp: 0.1,
        wheelMultiplier: 1,
        touchMultiplier: 1.5,
        smoothWheel: true,
        smoothTouch: false,
      });

      // Synchronize Lenis scrolling withGSAP's ScrollTrigger if use GSAP, but for now simple requestAnimationFrame
      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    </script>
    <script src="/js/script.js"></script>
  </body>
</html>
