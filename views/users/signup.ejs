<% layout('layouts/boilerplate') %>

<div class="container my-5 pb-5">
  <div class="row min-vh-50 align-items-center justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">
      <div class="card glass-card border-0 p-5 shadow-lg text-center" style="border-radius: 24px;">
        <i class="fa-solid fa-earth-americas fs-1 mb-3" style="color: var(--primary-color);"></i>
        <h2 class="fw-bold text-dark mb-2">Join Meridian</h2>
        <p class="text-muted mb-4 pb-2">Discover and book the world's best spaces</p>
        
        <form action="/signup" method="POST" class="needs-validation text-start" novalidate>
          <div class="row">
            <div class="col-md-12 mb-4">
              <label for="username" class="form-label text-muted d-block mb-2 ms-1"><i class="fa-regular fa-user me-2"></i> Username</label>
              <input type="text" id="username" name="username" class="form-control auth-input" placeholder="Username" required />
              <div class="invalid-feedback ps-2">Please enter a unique username.</div>
            </div>
            
            <div class="col-md-12 mb-4">
              <label for="email" class="form-label text-muted d-block mb-2 ms-1"><i class="fa-regular fa-envelope me-2"></i> Email Address</label>
              <input type="email" id="email" name="email" class="form-control auth-input" placeholder="Email" required />
              <div class="invalid-feedback ps-2">Please enter a valid email.</div>
            </div>

            <div class="col-md-12 mb-4">
              <label for="password" class="form-label text-muted d-block mb-2 ms-1"><i class="fa-solid fa-lock me-2"></i> Create Password</label>
              <input type="password" id="password" name="password" class="form-control auth-input" placeholder="Password" required />
              <div class="invalid-feedback ps-2">Please enter a password.</div>
            </div>
          </div>

          <button class="btn btn-submit py-3 fs-5 rounded-pill w-100 text-white shadow-sm mt-2 mb-3">Sign Up</button>
          <p class="text-muted text-center mt-3">Already have an account? <a href="/login" class="fw-bold">Login</a></p>
        </form>
      </div>
    </div>
  </div>
</div>