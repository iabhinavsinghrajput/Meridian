<% layout('layouts/boilerplate') %>

<div class="container my-5 pb-5">
  <div class="row min-vh-50 align-items-center justify-content-center mt-4">
    <div class="col-md-6 col-lg-5 col-xl-4">
      <div class="card glass-card border-0 p-4 p-md-5 shadow-lg text-center" style="border-radius: 28px;">
        <i class="fa-solid fa-earth-americas fs-1 mb-3" style="color: var(--primary-color);"></i>
        <h2 class="fw-bold text-dark mb-1">Join Meridian</h2>
        <p class="text-muted mb-4">Discover and book the world's best spaces</p>
        
        <form action="/signup" method="POST" class="needs-validation text-start" novalidate>
          <div class="mb-3">
            <input type="text" id="username" name="username" class="form-control auth-input" placeholder="Username" required />
            <div class="invalid-feedback ps-2">Please enter a unique username.</div>
          </div>
          
          <div class="mb-3">
            <input type="email" id="email" name="email" class="form-control auth-input" placeholder="Email Address" required />
            <div class="invalid-feedback ps-2">Please enter a valid email.</div>
          </div>

          <div class="mb-4">
            <input type="password" id="password" name="password" class="form-control auth-input" placeholder="Password" required />
            <div class="invalid-feedback ps-2">Please enter a password.</div>
          </div>

          <button class="btn btn-submit py-3 fs-5 rounded-pill w-100 text-white shadow-sm mt-2 mb-3">Sign Up</button>
          <p class="text-muted text-center mt-3 small">Already have an account? <a href="/login" class="fw-bold">Login</a></p>
        </form>
      </div>
    </div>
  </div>
      </div>
    </div>
  </div>
</div>