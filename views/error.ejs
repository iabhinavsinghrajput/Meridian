<% layout("layouts/boilerplate") %> // This is the error page template. It displays a user-friendly error message when something goes wrong in the application. The error message is passed in as a variable called "message". The page includes a link to return to the homepage or explore listings.

<div class="container my-5 max-w-4xl mx-auto flex-grow-1 d-flex flex-column justify-content-center">
  <div class="row w-100 justify-content-center m-0">
    <div class="col-md-8 col-lg-6 text-center">
      <div class="card glass-card border-0 p-5 shadow-lg shadow-danger" style="border-radius: 20px;">
        <div class="mb-4">
          <div class="bg-danger d-inline-flex justify-content-center align-items-center text-white rounded-circle shadow" style="width: 80px; height: 80px; opacity: 0.9;">
            <i class="fa-solid fa-triangle-exclamation fa-2x"></i>
          </div>
        </div>
        <h2 class="fw-bold text-dark mb-3">Oops! Something went wrong.</h2>
        <p class="text-danger fs-5 mb-4 fw-semibold p-3 bg-light rounded text-break" style="border: 1px solid #ffcccc;">
          <%= message %>
        </p>
        <p class="text-muted mb-4">We're sorry for the inconvenience. Please return to the homepage or try again later.</p>
        <a href="/listings" class="btn btn-dark py-3 px-5 rounded-pill shadow-sm fw-bold"><i class="fa-solid fa-arrow-left me-2"></i> Back to Explore</a>
      </div>
    </div>
  </div>
</div>
