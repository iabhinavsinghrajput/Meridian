<% layout('layouts/boilerplate') %>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<div class="container mt-4 mb-5 pt-3" style="max-width: 1050px; margin: auto;">
  <!-- Title and Header info -->
  <div class="mb-4">
    <h1 class="show-title d-inline-block"><%= listing.title %></h1>
    <div class="d-flex justify-content-between align-items-center">
      <div class="text-muted fw-semibold small">
        <i class="fa-solid fa-star text-warning"></i> New &nbsp;·&nbsp;
        <a href="#reviews" class="text-dark border-bottom border-dark border-1 text-decoration-none pb-0">Reviews</a> &nbsp;·&nbsp;
        <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %>
      </div>
      
      <div class="d-flex gap-3">
        <!-- Save Form -->
        <form action="/profile/save/<%= listing._id %>" method="POST" class="m-0">
          <% 
            let isSaved = false;
            if(currUser && currUser.savedListings && currUser.savedListings.includes(listing._id)) {
              isSaved = true;
            }
          %>
          <button type="submit" class="btn btn-link text-dark fw-semibold text-decoration-none align-items-center d-flex p-0 shadow-none small">
            <i class="<%= isSaved ? 'fa-solid text-danger' : 'fa-regular' %> fa-heart me-2 fs-5"></i> 
            <span><%= isSaved ? 'Saved' : 'Save' %></span>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Hero Image -->
  <div class="position-relative overflow-hidden rounded-4 shadow-lg mb-5">
    <img src="<%= listing.image.url %>" class="hero-img img-fluid w-100 object-fit-cover m-0" style="height: 500px" alt="listing_image"/>
  </div>

  <div class="row mt-4">
    <!-- Left Column: Details -->
    <div class="col-md-7 pe-md-5 mb-4">
      <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-4">
        <div>
          <h3 class="fw-bold mb-1 fs-4">Hosted by <%= listing.owner.username %></h3>
          <p class="text-muted small m-0"><i class="fa-solid fa-certificate text-primary me-1"></i> Superhost · Highly rated host</p>
        </div>
        <div class="host-avatar">
          <%= listing.owner.username.charAt(0).toUpperCase() %>
        </div>
      </div>
      
      <div class="desc fs-5 text-dark mb-5" style="line-height: 1.8; font-weight: 300;">
        <%= listing.description %>
      </div>

      <hr class="my-5" style="opacity: 0.05;">

      <!-- Interactive Map (Leaflet) -->
      <h4 class="fw-bold mb-4 ms-1">Where you'll be</h4>
      <div id="map" class="mb-5 rounded-4 shadow-sm border" style="height: 400px; z-index: 1; border: 1px solid rgba(0,0,0,0.05) !important;"></div>
    </div>

    <!-- Right Column: Price Card widget -->
    <div class="col-md-5 ps-md-4">
      <div class="card show-card position-sticky shadow-lg" style="top: 100px;">
        <div class="card-body p-3">
          <h3 class="fw-bold mb-4 fs-3">&#8377; <%= listing.price.toLocaleString("en-IN") %> <span class="fs-6 fw-normal text-muted">/ night</span></h3>
          
          <% if(!currUser || !currUser._id.equals(listing.owner._id)){ %>
            <form action="/listings/<%= listing._id %>/book" method="GET" id="reservation-form">
              <div class="border rounded-4 p-4 mb-4 bg-light date-input-group shadow-sm">
                 <div class="mb-3">
                    <label class="small fw-bold text-dark mb-2 d-block text-uppercase letter-spacing-1 ms-2">Check-in</label>
                    <input type="date" name="checkin" id="checkin" class="form-control custom-date-input" placeholder="DD-MM-YYYY" required>
                 </div>
                 <div class="mb-4">
                    <label class="small fw-bold text-dark mb-2 d-block text-uppercase letter-spacing-1 ms-2">Check-out</label>
                    <input type="date" name="checkout" id="checkout" class="form-control custom-date-input" placeholder="DD-MM-YYYY" required>
                 </div>
                 <hr class="my-4" style="opacity: 0.1;">
                 <div id="reservation-calc" class="text-center d-none">
                    <div class="d-flex justify-content-between small mb-2 text-muted">
                        <span id="calc-days">0 nights x ₹0</span>
                        <span id="calc-total">₹0</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold text-dark mt-3">
                        <span class="fs-6">Due Now (30%)</span>
                        <span id="calc-downpayment" class="text-primary fs-5">₹0</span>
                    </div>
                 </div>
                 <p id="reservation-prompt" class="text-center m-0 small text-muted">
                    <i class="fa-solid fa-circle-info text-primary me-2"></i>Select dates to see exact total
                 </p>
              </div>
              <button type="submit" class="btn btn-submit rounded-pill w-100 fs-5 py-3 text-white shadow-sm fw-bold">Reserve</button>
            </form>
          <% } %>

          <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
            <div class="d-flex flex-column gap-3 mt-4">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark text-white rounded-pill py-3 w-100 fw-bold shadow-sm"> 
                 <i class="fa-regular fa-pen-to-square me-2"></i> Edit Details
              </a>
              <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0 delete-form-sa" data-item-type="listing">
                <button class="btn btn-outline-danger rounded-pill py-3 w-100 fw-bold border-2">
                   <i class="fa-regular fa-trash-can me-2"></i> Delete Listing
                </button>
              </form>
            </div>
          <% } %>

          <div class="text-center mt-4 text-muted small fw-semibold"><i class="fa-solid fa-shield-halved me-1 text-success"></i> Meridian Guarantee</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Reviews Section -->
  <hr class="my-5" style="opacity: 0.1;" id="reviews">
  <div class="row">
    <div class="col-12">
      <h3 class="fw-bold mb-5 fs-4"><i class="fa-solid fa-star text-warning me-2"></i> Verified Reviews</h3>
    </div>
    
    <% if(currUser){ %>
      <div class="col-md-6 mb-5 pe-md-4">
        <div class="card border-0 glass-card p-4 shadow-sm rounded-4" style="background: rgba(0, 0, 0, 0.02);">
          <h5 class="fw-bold mb-4 text-dark ms-1">Leave a Review</h5>
          <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-4">
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-4">
              <textarea name="review[comment]" rows="4" class="form-control bg-white shadow-none p-3 auth-input" required placeholder="Share your experience with future guests..."></textarea>
              <div class="invalid-feedback">Review cannot be empty.</div>
            </div>
            <button class="btn btn-dark rounded-pill px-5 py-3 shadow-sm fw-bold w-100">Submit Review</button>
          </form>
        </div>
      </div>
    <% } %>

    <div class="col-md-12">
      <div class="row g-4">
        <% if(listing.reviews.length === 0) { %>
           <div class="text-center py-5 bg-light rounded-4 border border-dashed mx-3">
              <p class="text-muted fs-5 m-0"><i class="fa-regular fa-face-laugh-beam text-primary me-2"></i> No reviews yet. Be the first to leave one!</p>
           </div>
        <% } %>
        <% for(review of listing.reviews){ %>
          <div class="col-md-6">
            <div class="card review-card border shadow-sm rounded-4 h-100 p-4">
              <div class="card-body p-0 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                   <div class="bg-dark text-white rounded-circle d-flex justify-content-center align-items-center fw-bold" style="width: 45px; height: 45px; font-size:1rem;">
                      <%= review.author.username.charAt(0).toUpperCase() %>
                   </div>
                   <div class="ms-3">
                      <h6 class="mb-0 fw-bold"><%= review.author.username %></h6>
                      <p class="starability-result m-0 mt-1" data-rating="<%= review.rating %>" style="transform: scale(0.6); transform-origin: left;"></p>
                   </div>
                </div>
                <p class="card-text text-muted fs-6 flex-grow-1" style="line-height: 1.6;"><%= review.comment %></p>          
              </div>
              <% if(currUser && currUser._id.equals(review.author._id)) { %>
                <div class="mt-3 pt-3 border-top">
                  <form class="text-start delete-form-sa" method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" data-item-type="review">
                    <button class="btn btn-sm text-danger shadow-none p-0 fw-bold small"><i class="fa-solid fa-trash me-1"></i> Delete</button>
                  </form>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  document.addEventListener('DOMContentLoaded', async () => {
    // --- Reservation Calculator Logic ---
    const checkin = document.getElementById('checkin');
    const checkout = document.getElementById('checkout');
    const prompt = document.getElementById('reservation-prompt');
    const calcDiv = document.getElementById('reservation-calc');
    const listingPrice = Number("<%= listing.price %>");

    const calculateTotal = () => {
       if(checkin.value && checkout.value) {
           const inDate = new Date(checkin.value);
           const outDate = new Date(checkout.value);
           if (outDate > inDate) {
              const diffTime = Math.abs(outDate - inDate);
              const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
              const total = diffDays * listingPrice;
              const downpayment = total * 0.30;
              
              document.getElementById('calc-days').innerText = `${diffDays} nights x ₹${listingPrice.toLocaleString("en-IN")}`;
              document.getElementById('calc-total').innerText = `₹${total.toLocaleString("en-IN")}`;
              document.getElementById('calc-downpayment').innerText = `₹${downpayment.toLocaleString("en-IN")}`;
              
              prompt.classList.add('d-none');
              calcDiv.classList.remove('d-none');
           } else {
              prompt.classList.remove('d-none');
              calcDiv.classList.add('d-none');
           }
       }
    };
    checkin.addEventListener('change', calculateTotal);
    checkout.addEventListener('change', calculateTotal);

    // --- Basic Leaflet Map Init ---
    let mapElement = document.getElementById('map');
    if (mapElement) {
        const map = L.map('map', {
            scrollWheelZoom: false, // Prevents accidental zooming while scrolling the page
            zoomControl: true
        }).setView([20.5937, 78.9629], 2); 
        
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        // Fix rendering issues in case container was hidden or flexed
        const fixMapSize = () => { map.invalidateSize(); };
        setTimeout(fixMapSize, 100);
        setTimeout(fixMapSize, 1000);

        // Geocode the location
        const address = `<%= listing.location %>, <%= listing.country %>`;
        const geocode = async () => {
            try {
                const resp = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}`);
                const results = await resp.json();
                
                if(results && results.length > 0) {
                    const { lat, lon } = results[0];
                    L.marker([lat, lon]).addTo(map)
                        .bindPopup(`<h6 class="fw-bold"><%= listing.title %></h6><p class="small m-0">${address}</p>`)
                        .openPopup();
                    map.setView([lat, lon], 13); // Zoom into neighborhood level
                }
            } catch(e) {
                console.error("Geocoding failed:", e);
            }
        };
        geocode();
    }
  });
</script>
