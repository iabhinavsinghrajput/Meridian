<% layout('layouts/boilerplate') %>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<div class="container mt-4 mb-5 pt-3" style="max-width: 1000px; margin: auto;">
  <!-- Title and Header info -->
  <h1 class="show-title"><%= listing.title %></h1>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted fw-semibold">
      <i class="fa-solid fa-star text-warning"></i> New &nbsp;·&nbsp;
      <a href="#reviews" class="text-dark border-bottom border-dark border-1 text-decoration-none pb-0">Reviews</a> &nbsp;·&nbsp;
      <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %>
    </div>
    
    <!-- Save Form -->
    <form action="/profile/save/<%= listing._id %>" method="POST" class="m-0">
      <% 
        let isSaved = false;
        if(currUser && currUser.savedListings && currUser.savedListings.includes(listing._id)) {
          isSaved = true;
        }
      %>
      <button type="submit" class="btn btn-link text-danger fw-semibold text-decoration-none align-items-center d-flex p-0 shadow-none">
        <i class="<%= isSaved ? 'fa-solid' : 'fa-regular' %> fa-heart me-2 fs-5"></i> 
        <span><%= isSaved ? 'Saved' : 'Save' %></span>
      </button>
    </form>
  </div>

  <!-- Hero Image -->
  <img src="<%= listing.image.url %>" class="hero-img img-fluid w-100 object-fit-cover rounded-4" style="height: 450px" alt="listing_image"/>

  <div class="row mt-4">
    <!-- Left Column: Details -->
    <div class="col-md-7 border-end pe-md-4 mb-4">
      <h3 class="fw-bold mb-1">Hosted by <%= listing.owner.username %></h3>
      <p class="text-muted mb-4 border-bottom pb-4"><i class="fa-solid fa-certificate text-primary"></i> Superhost · Highly rated host</p>
      
      <div class="desc fs-5 text-dark" style="line-height: 1.6;">
        <%= listing.description %>
      </div>

      <hr class="my-4">

      <!-- Interactive Map (Leaflet) -->
      <h4 class="fw-bold mb-3">Where you'll be</h4>
      <div id="map" class="mb-5 rounded-4 shadow-sm" style="height: 350px; z-index: 1;"></div>
    </div>

    <!-- Right Column: Price Card widget -->
    <div class="col-md-5 ps-md-4">
      <div class="card show-card position-sticky shadow-sm border" style="top: 100px; border-radius: 20px;">
        <div class="card-body p-4">
          <h3 class="fw-bold mb-4">&#8377; <%= listing.price.toLocaleString("en-IN") %> <span class="fs-6 fw-normal text-muted">/ night</span></h3>
          
          <% if(!currUser || !currUser._id.equals(listing.owner._id)){ %>
            <form action="/listings/<%= listing._id %>/book" method="GET" id="reservation-form">
              <div class="border rounded p-3 mb-4 bg-light date-input-group">
                 <div class="row g-2 mb-2">
                    <div class="col-6 position-relative">
                      <label class="small fw-bold text-muted mb-1 d-block">CHECK-IN</label>
                      <input type="date" name="checkin" id="checkin" class="form-control form-control-sm custom-date-input" required>
                    </div>
                    <div class="col-6 position-relative">
                      <label class="small fw-bold text-muted mb-1 d-block">CHECK-OUT</label>
                      <input type="date" name="checkout" id="checkout" class="form-control form-control-sm custom-date-input" required>
                    </div>
                 </div>
                 <hr class="my-2 border-secondary-subtle">
                 <div id="reservation-calc" class="text-center d-none">
                    <div class="d-flex justify-content-between small mb-1 text-muted">
                        <span id="calc-days">0 nights x ₹0</span>
                        <span id="calc-total">₹0</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold text-dark mt-2">
                        <span>Due Now (30%)</span>
                        <span id="calc-downpayment" class="text-primary">₹0</span>
                    </div>
                 </div>
                 <p id="reservation-prompt" class="text-center m-0 small text-muted"><i class="fa-regular fa-calendar text-primary me-1"></i> Select dates to see exact total</p>
              </div>
              <button type="submit" class="btn btn-submit rounded-pill w-100 fs-5 py-3 text-white shadow-sm fw-bold">Reserve</button>
            </form>
          <% } %>

          <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
            <div class="d-flex flex-column gap-2 mt-4">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark text-white rounded-pill py-2 w-100 fw-semibold"> 
                 <i class="fa-regular fa-pen-to-square me-2"></i> Edit Details
              </a>
              <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0 delete-form-sa">
                <button class="btn btn-outline-danger rounded-pill py-2 w-100 fw-semibold">
                   <i class="fa-regular fa-trash-can me-2"></i> Delete Listing
                </button>
              </form>
            </div>
          <% } %>

          <div class="text-center mt-3 text-muted small"><i class="fa-solid fa-shield-halved me-1 text-success"></i> Meridian Guarantee</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Reviews Section -->
  <hr class="my-5" id="reviews">
  <div class="row">
    <div class="col-12">
      <h3 class="fw-bold mb-4"><i class="fa-solid fa-star text-warning me-2"></i> Verified Reviews</h3>
    </div>
    
    <% if(currUser){ %>
      <div class="col-md-6 mb-5">
        <div class="card border-0 glass-card p-4 shadow-sm rounded-4" style="background: rgba(0,180,216,0.03);">
          <h5 class="fw-bold mb-3 text-dark">Leave a Review</h5>
          <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3">
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-3">
              <textarea name="review[comment]" rows="4" class="form-control bg-white shadow-none" required placeholder="Share your experience with future guests..."></textarea>
              <div class="invalid-feedback">Review cannot be empty.</div>
            </div>
            <button class="btn btn-dark rounded-pill px-5 py-2 shadow-sm fw-bold">Submit</button>
          </form>
        </div>
      </div>
    <% } %>

    <div class="col-md-12">
      <div class="row g-4">
        <% if(listing.reviews.length === 0) { %>
           <p class="text-muted fs-5 ms-3"><i class="fa-regular fa-face-laugh-beam text-primary me-2"></i> No reviews yet. Be the first to leave one!</p>
        <% } %>
        <% for(review of listing.reviews){ %>
          <div class="col-md-6">
            <div class="card border shadow-sm rounded-4 h-100 p-4 bg-white">
              <div class="card-body p-0 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                   <div class="bg-dark text-white rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px; font-size:1.2rem;">
                      <i class="fa-solid fa-user"></i>
                   </div>
                   <div class="ms-3">
                      <h6 class="mb-0 fw-bold fs-5"><%= review.author.username %></h6>
                      <p class="starability-result m-0 mt-1" data-rating="<%= review.rating %>" style="transform: scale(0.65); transform-origin: left;"></p>
                   </div>
                </div>
                <p class="card-text text-dark fs-6 flex-grow-1" style="line-height: 1.5;"><%= review.comment %></p>          
              </div>
              <% if(currUser && currUser._id.equals(review.author._id)) { %>
                <div class="mt-3 pt-3 border-top">
                  <form class="text-start delete-form-sa" method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                    <button class="btn btn-sm text-danger shadow-none p-0 fw-bold"><i class="fa-solid fa-trash me-1"></i> Delete</button>
                  </form>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  document.addEventListener('DOMContentLoaded', async () => {
    // --- Reservation Calculator Logic ---
    const checkin = document.getElementById('checkin');
    const checkout = document.getElementById('checkout');
    const prompt = document.getElementById('reservation-prompt');
    const calcDiv = document.getElementById('reservation-calc');
    const listingPrice = Number("<%= listing.price %>");

    const calculateTotal = () => {
       if(checkin.value && checkout.value) {
           const inDate = new Date(checkin.value);
           const outDate = new Date(checkout.value);
           if (outDate > inDate) {
              const diffTime = Math.abs(outDate - inDate);
              const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
              const total = diffDays * listingPrice;
              const downpayment = total * 0.30;
              
              document.getElementById('calc-days').innerText = `${diffDays} nights x ₹${listingPrice.toLocaleString("en-IN")}`;
              document.getElementById('calc-total').innerText = `₹${total.toLocaleString("en-IN")}`;
              document.getElementById('calc-downpayment').innerText = `₹${downpayment.toLocaleString("en-IN")}`;
              
              prompt.classList.add('d-none');
              calcDiv.classList.remove('d-none');
           } else {
              prompt.classList.remove('d-none');
              calcDiv.classList.add('d-none');
           }
       }
    };
    checkin.addEventListener('change', calculateTotal);
    checkout.addEventListener('change', calculateTotal);

    // --- Basic Leaflet Map Init ---
    const map = L.map('map').setView([20.5937, 78.9629], 4); 
    
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap'
    }).addTo(map);

    // Geocode the location
    const address = "<%= listing.location %>, <%= listing.country %>";
    try {
      const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}`);
      const data = await response.json();
      
      if(data && data.length > 0) {
        const lat = data[0].lat;
        const lon = data[0].lon;
        map.setView([lat, lon], 12);
        L.marker([lat, lon]).addTo(map)
          .bindPopup(`<b><%= listing.title %></b><br>${address}`)
          .openPopup();
      }
    } catch(err) {
      console.log("Geocoding failed", err);
    }
  });
</script>
