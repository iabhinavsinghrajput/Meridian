<% layout('layouts/boilerplate') %>
<% const categories = ["Trending", "Rooms", "Iconic Cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Artic", "Domes", "Boats"]; %>

<div class="container mt-2 mb-5">
  <div class="row justify-content-center mt-0">
    <div class="col-lg-6 col-md-8 col-xl-5">
      <div class="card glass-card border-0 p-4 shadow-lg" style="border-radius: 28px;">
        <div class="d-flex align-items-center mb-4 border-bottom pb-4">
           <img src="<%= originalImageUrl %>" class="rounded-circle object-fit-cover shadow-sm me-3" style="width: 70px; height: 70px;" alt="original" />
           <div>
             <h2 class="fw-bold text-dark mb-1 fs-3">Edit Your Listing</h2>
             <p class="text-muted m-0 small">Update your property details below</p>
           </div>
        </div>

        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
          <!-- Title -->
          <div class="mb-3">
            <label for="title" class="form-label text-muted ms-2 small fw-bold">Listing Title</label>
            <input type="text" id="title" class="form-control auth-input fw-bold" name="listing[title]" value="<%= listing.title %>" required />
            <div class="invalid-feedback ps-2">Please enter a title.</div>
          </div>

          <!-- Description -->
          <div class="mb-3">
            <label for="description" class="form-label text-muted ms-2 small fw-bold">Description</label>
            <textarea id="description" class="form-control auth-input" name="listing[description]" style="height: 110px" required><%= listing.description %></textarea>
            <div class="invalid-feedback ps-2">Please enter a description.</div>
          </div>

          <!-- row 1 -->
          <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label for="category" class="form-label text-muted ms-2 small fw-bold">Category</label>
                <select id="category" name="listing[category]" class="form-select auth-input" required>
                  <% for(let cat of categories) { %>
                    <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %>><%= cat %></option>
                  <% } %>
                </select>
                <div class="invalid-feedback ps-2">Please select a category.</div>
            </div>

            <div class="col-md-6">
                <label for="price" class="form-label text-muted ms-2 small fw-bold">Price per night</label>
                <input type="number" id="price" class="form-control auth-input fw-bold" name="listing[price]" value="<%= listing.price %>" required />
                <div class="invalid-feedback ps-2">Please enter a price.</div>
            </div>
          </div>

          <!-- row 2 -->
          <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label for="location" class="form-label text-muted ms-2 small fw-bold">Location</label>
                <input type="text" id="location" class="form-control auth-input" name="listing[location]" value="<%= listing.location %>" required />
                <div class="invalid-feedback ps-2">Please enter a location.</div>
            </div>

            <div class="col-md-6">
                <label for="country" class="form-label text-muted ms-2 small fw-bold">Country</label>
                <input type="text" id="country" class="form-control auth-input" name="listing[country]" value="<%= listing.country %>" required />
                <div class="invalid-feedback ps-2">Please enter a country.</div>
            </div>
          </div>

          <!-- Image Upload -->
          <div class="mb-4">
            <label for="image" class="form-label text-muted ms-2 small fw-bold">Update Image (Optional)</label>
            <input type="file" id="image" class="form-control auth-input pt-2" name="listing[image]" />
          </div>

          <button class="btn btn-submit py-3 fs-5 rounded-pill w-100 text-white shadow-sm mt-2">
            <i class="fa-solid fa-check-circle me-2"></i> Save Changes
          </button>
        </form>
      </div>
    </div>
  </div>
      </div>
    </div>
  </div>
</div>
