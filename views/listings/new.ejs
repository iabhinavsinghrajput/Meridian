<% layout('layouts/boilerplate') %>

<% const categories = ["Trending", "Rooms", "Iconic Cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Artic", "Domes", "Boats"]; %>

<div class="container mt-2 mb-5">
  <div class="row justify-content-center mt-0">
    <div class="col-lg-6 col-md-8 col-xl-5">
      <div class="card glass-card border-0 p-4 shadow-lg" style="border-radius: 28px;">
        <div class="text-center mb-4">
           <h2 class="fw-bold text-dark mb-1">Create New Listing</h2>
           <p class="text-muted">Earn money by sharing your space with the world</p>
        </div>

        <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
          <!-- Title -->
          <div class="mb-3">
            <input type="text" id="title" placeholder="Catchy Title" class="form-control auth-input" name="listing[title]" required />
            <div class="invalid-feedback ps-2">Please enter a title.</div>
          </div>

          <!-- Description -->
          <div class="mb-3">
            <textarea id="description" class="form-control auth-input" placeholder="Describe your space..." name="listing[description]" style="height: 120px" required></textarea>
            <div class="invalid-feedback ps-2">Please enter a description.</div>
          </div>

          <!-- row 1 -->
          <div class="row g-3 mb-3">
            <div class="col-md-6">
                <select id="category" name="listing[category]" class="form-select auth-input" required>
                  <option value="" disabled selected>Select Category...</option>
                  <% for(let cat of categories) { %>
                    <option value="<%= cat %>"><%= cat %></option>
                  <% } %>
                </select>
                <div class="invalid-feedback ps-2">Please select a category.</div>
            </div>

            <div class="col-md-6">
                <input type="number" id="price" placeholder="Price per night" class="form-control auth-input" name="listing[price]" required />
                <div class="invalid-feedback ps-2">Please enter a valid price.</div>
            </div>
          </div>

          <!-- row 2 -->
          <div class="row g-3 mb-4">
            <div class="col-md-6">
                <input type="text" id="location" placeholder="City / Location" class="form-control auth-input" name="listing[location]" required />
                <div class="invalid-feedback ps-2">Please enter a location.</div>
            </div>

            <div class="col-md-6">
                <input type="text" id="country" placeholder="Country" class="form-control auth-input" name="listing[country]" required />
                <div class="invalid-feedback ps-2">Please enter a country.</div>
            </div>
          </div>

          <!-- Image Upload (Refined) -->
          <div class="mb-4">
            <label for="image" class="form-label text-muted ms-2 small fw-bold">Upload Listing Image</label>
            <input type="file" id="image" class="form-control auth-input pt-2" name="listing[image]" required />
            <div class="invalid-feedback ps-2">Please upload a photo.</div>
          </div>

          <button class="btn btn-submit py-3 fs-5 rounded-pill w-100 text-white shadow-sm mt-2">Host Your Space</button>
        </form>
      </div>
    </div>
  </div>
      </div>
    </div>
  </div>
</div>
